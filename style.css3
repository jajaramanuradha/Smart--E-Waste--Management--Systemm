*{margin:0;padding:0;box-sizing:border-box}body{font-family:Arial,sans-serif;background:#f4f8f5;color:#1f2937;line-height:1.6}.container{width:92%;max-width:1150px;margin:auto}.navbar{background:#166534;color:white;position:sticky;top:0;z-index:1000}.nav-content{min-height:68px;display:flex;align-items:center;justify-content:space-between}.logo{color:white;text-decoration:none;font-size:21px;font-weight:bold}.nav-links{display:flex;gap:18px}.nav-links a{color:white;text-decoration:none;font-size:14px}.menu-btn{display:none;background:none;border:0;color:white;font-size:25px}.hero{margin-top:35px;padding:70px 45px;border-radius:22px;background:linear-gradient(135deg,#166534,#22c55e);color:white}.hero h1{font-size:42px;max-width:750px;margin:10px 0}.hero p{max-width:720px;font-size:17px}.tag{font-weight:bold}.hero-buttons{margin-top:25px;display:flex;gap:12px;flex-wrap:wrap}.btn{display:inline-block;border:0;border-radius:9px;padding:12px 20px;background:#166534;color:white;text-decoration:none;cursor:pointer;font-weight:bold}.hero .btn{background:white;color:#166534}.btn.secondary{background:#374151}.section{margin:45px 0}.section h2{margin-bottom:20px}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.card,.form-card,.about-card{background:white;padding:25px;border-radius:15px;box-shadow:0 5px 20px rgba(0,0,0,.06)}.card span{font-size:30px}.card h3{margin:10px 0}.page-header{padding:40px 0 25px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.stat-card{background:white;padding:25px;border-radius:15px;text-align:center;box-shadow:0 5px 20px rgba(0,0,0,.06)}.stat-card span{font-size:28px}.stat-card h3{font-size:30px;color:#166534}.form-card{max-width:700px;margin-bottom:35px}form{display:flex;flex-direction:column;gap:9px}label{font-weight:bold;margin-top:8px}input,select,textarea{width:100%;padding:12px;border:1px solid #d1d5db;border-radius:8px;font-size:15px}textarea{resize:vertical}form .btn{margin-top:15px;width:fit-content}.table-wrapper{overflow-x:auto;background:white;border-radius:12px}table{width:100%;border-collapse:collapse}th,td{padding:13px;border-bottom:1px solid #e5e7eb;text-align:left}th{background:#dcfce7;color:#14532d}.status{background:#fef3c7;padding:5px 10px;border-radius:20px;font-size:13px}.alert{margin-top:20px;padding:13px 16px;border-radius:8px}.alert.success{background:#dcfce7;color:#166534}.empty{background:white;padding:25px;border-radius:12px;text-align:center}.notice{margin:35px 0;padding:20px;border-left:5px solid #f59e0b;background:#fffbeb}.about-card{margin-bottom:40px}.about-card h2{margin:20px 0 8px}.about-card h2:first-child{margin-top:0}.about-card ul{padding-left:25px}footer{margin-top:60px;padding:25px 0;background:#14532d;color:white;text-align:center}@media(max-width:850px){.cards,.stats{grid-template-columns:repeat(2,1fr)}.nav-links{display:none;position:absolute;top:68px;left:0;right:0;background:#166534;flex-direction:column;padding:18px 5%}.nav-links.show{display:flex}.menu-btn{display:block}.hero h1{font-size:34px}}@media(max-width:550px){.cards,.stats{grid-template-columns:1fr}.hero{padding:45px 25px}.hero h1{font-size:29px}}
