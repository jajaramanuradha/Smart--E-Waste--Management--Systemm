{% extends "base.html" %}{% block title %}Home - Smart E-Waste{% endblock %}{% block content %}
<section class="hero"><p class="tag">♻️ Sustainable Technology</p><h1>Smart E-Waste Management System</h1><p>Manage electronic waste efficiently with smart categorization, reuse, repair, recycling recommendations and collection requests.</p><div class="hero-buttons"><a href="{{ url_for('add_waste') }}" class="btn">Register E-Waste</a><a href="{{ url_for('dashboard') }}" class="btn secondary">View Dashboard</a></div></section>
<section class="section"><h2>Key Features</h2><div class="cards"><div class="card"><span>📱</span><h3>E-Waste Registration</h3><p>Register phones, laptops, batteries, printers and other electronic items.</p></div><div class="card"><span>🔄</span><h3>Smart Recommendation</h3><p>Get reuse, repair or recycling recommendations based on item condition.</p></div><div class="card"><span>🚚</span><h3>Collection Request</h3><p>Submit a request for responsible collection of electronic waste.</p></div><div class="card"><span>📊</span><h3>Dashboard</h3><p>Track registered e-waste and collection requests through statistics.</p></div></div></section>{% endblock %}
